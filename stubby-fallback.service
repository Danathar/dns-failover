[Unit]
Description=Independent DNS-over-TLS backup for house DNS
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/stubby -l -v 5 -C /etc/stubby/fallback.yml
RuntimeDirectory=stubby-fallback
WorkingDirectory=/run/stubby-fallback
DynamicUser=true
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
