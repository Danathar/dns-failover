{
    "$comment": "Guards credential handling in the Tailscale monitor and keeps secrets and site-specific ControlD profile IDs out of the repository. Evaluated by scripts/check-policies.mjs (checkFileRules and checkSecretScan; matches are reported by file and line, never echoed). See docs/security/SECURITY-AI.md, sections 'Credentials' and 'Site-specific data'.",
    "files": [
        {
            "path": "tailscale-dns-failover/configure.py",
            "required": [
                {
                    "pattern": "'auto_restore':\\s*False",
                    "why": "configure.py must write auto_restore false; automatic restore is opt-in by editing the file"
                },
                {
                    "pattern": "os\\.O_CREAT \\| os\\.O_EXCL, 0o600\\)",
                    "why": "the config must be created exclusively with mode 0600"
                },
                {
                    "pattern": "mode=0o700",
                    "why": "the config directory must be created with mode 0700"
                },
                {
                    "pattern": "^if path\\.exists\\(\\):",
                    "why": "configure.py must refuse to overwrite an existing config"
                },
                {
                    "pattern": "getpass\\.getpass\\(",
                    "why": "the client secret must be read without echo"
                }
            ],
            "forbidden": [
                {
                    "pattern": "auto_restore['\"]?\\s*[:=]\\s*True",
                    "why": "configure.py must not enable auto_restore"
                },
                {
                    "pattern": "\\bprint\\([^\\n]*client_secret",
                    "why": "the client secret must never be printed"
                },
                {
                    "pattern": "0o[0-7][1-7][0-7]|0o[0-7][0-7][1-7]",
                    "why": "file and directory modes must not grant group or other access"
                }
            ]
        },
        {
            "path": "tailscale-dns-failover/monitor.py",
            "required": [
                {
                    "pattern": "config\\.get\\('auto_restore', False\\)",
                    "why": "auto_restore must default to false when absent from the config"
                }
            ],
            "forbidden": [
                {
                    "pattern": "get\\(['\"]auto_restore['\"],\\s*True\\)",
                    "why": "auto_restore must not default to true"
                },
                {
                    "pattern": "\\bprint\\([^\\n]*client_secret",
                    "why": "the client secret must never be printed"
                }
            ]
        },
        {
            "path": "tailscale-dns-failover/tailscale-dns-failover.service",
            "required": [
                {
                    "pattern": "^UMask=0077\\s*$",
                    "why": "the service must run with UMask=0077 so state files are root-only"
                },
                {
                    "pattern": "^StateDirectoryMode=0700\\s*$",
                    "why": "the state directory must be mode 0700"
                }
            ]
        }
    ],
    "secretScan": {
        "excludeGlobs": [
            "policies/credential-safety.json"
        ],
        "tokenPatterns": [
            {
                "name": "Tailscale auth or API key",
                "pattern": "\\btskey-(?:api|auth|client|scim)-[A-Za-z0-9]{6,}"
            },
            {
                "name": "GitHub token",
                "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})"
            },
            {
                "name": "LLM API key",
                "pattern": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{30,}"
            },
            {
                "name": "AWS access key ID",
                "pattern": "\\bAKIA[0-9A-Z]{16}\\b"
            },
            {
                "name": "private key block",
                "pattern": "-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----"
            },
            {
                "name": "OAuth client secret in JSON",
                "pattern": "[\"']client_secret[\"']\\s*:\\s*[\"'](?!YOUR_|<)[^\"']{16,}[\"']"
            }
        ],
        "profileIdPatterns": [
            "\\b([A-Za-z0-9_-]+)\\.dns\\.controld\\.com\\b",
            "\\bdns\\.controld\\.com/([A-Za-z0-9_-]+)"
        ],
        "allowedProfileIds": [
            "YOUR_CONTROLD_PROFILE_ID",
            "PROFILE_ID",
            "YOUR_PROFILE_ID",
            "profile",
            "example"
        ]
    }
}
